  "keyFeatures": [
    "Gig management with full lifecycle from Draft to Settled",
    "Crew staffing with invitations, call lists, and availability tracking",
    "Drag-and-drop setlist builder with reusable song library",
    "E-signature contracts with white-label branding",
    "Crew payments via ACH direct deposit or card",
    "CRM with customers, venues, sponsors, and lead tracking",
    "Client portal for branded event experience",
    "CheckAI assistant and MCP server for AI agent integration",
    "iOS and Android mobile app with offline support",
    "Tours for grouping runs of shows with financial roll-ups",
    "Rounds digest for prioritized open items across all gigs",
    "Imports from Planning Center, Back On Stage, and Master Tour"
  ],
  "publicApiSurface": [
    "MCP server (Model Context Protocol for AI agents)",
    "n8n webhook for CRM sync",
    "Calendar feed subscription (iCal/ICS)",
    "Portal forms (lead capture, event questionnaires, feedback)",
    "Universal Event Format (UEF) JSON schema for imports",
    "QuickBooks Online integration",
    "HubSpot + Flex pipeline sync"
  ]
